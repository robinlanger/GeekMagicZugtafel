# Bahnhof (Name, EVA-Nummer oder DS100-Kürzel), wie auf https://dbf.finalrewind.org
STATION=Musterstadt

# IP-Adresse des GeekMagic-Displays (am besten im Router fest vergeben)
DEVICE_IP=192.168.x.x

# ultra (ESP8266) oder pro (ESP32)
DEVICE_PROFILE=ultra

# Optional: nur Züge, die über diesen Halt fahren (z. B. nur eine Fahrtrichtung)
#VIA=Musterstadt Hbf

# Optional: nur bestimmte Gleise, kommagetrennt
#PLATFORMS=1,2

# Optional: Überschrift statt Bahnhofsname
#TITLE=Heimweg

# Anzahl Zeilen (1–6) und Intervall in Sekunden (min. 60)
LIMIT=5
INTERVAL=60

TZ=Europe/Berlin
